# LLM Provider API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Turn limit & Execution Budget
# Maximum agent turns per run (default: 80, 0=unlimited). Web auto-continues up to 5 times.
MINI_AGENT_MAX_TURNS=80

# TUI policy defaults (omit to use the built-in policy defaults)
# MINI_AGENT_TUI_TOKEN_BUDGET=50000
# MINI_AGENT_TUI_TOOL_CALL_BUDGET=100
# MINI_AGENT_TUI_WRITE_CALL_BUDGET=20
# MINI_AGENT_TUI_DEADLINE_MS=300000
# MINI_AGENT_TUI_MAX_COMPACTIONS=8
# MINI_AGENT_TUI_SAME_ACTION_LIMIT=3
# MINI_AGENT_TUI_NO_PROGRESS_LIMIT=6
# MINI_AGENT_TUI_EMERGENCY_ITERATION_CAP=2000

# Auto-continue on max_tokens truncation
# When enabled, automatically retry with /continue when LLM output is truncated
MINI_AGENT_AUTO_CONTINUE_ON_TRUNCATE=true
# Maximum number of auto-continue attempts (0=unlimited, default: 3)
MINI_AGENT_MAX_AUTO_CONTINUES=3

# Layer 2 budget safety limit: shared token limit across parent and subagents
MINI_AGENT_GLOBAL_TOKEN_BUDGET=2000000

# Optional Vision Configuration
VISION_PROVIDER=zhipu
VISION_MODEL=GLM-4.6V-Flash
