{
  "name": "@krischen99999/mini-agent-loop",
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "description": "Extensible AI agent runtime for terminal, CLI, and HTTP workflows",
  "bin": {
    "mini-agent-loop": "dist/tui.js",
    "mini-agent-loop-tui": "dist/tui.js",
    "mini-agent-loop-run": "dist/cli.js",
    "mini-agent-loop-terminal": "dist/terminal.js"
  },
  "files": [
    "version-check.js",
    "dist",
    "README.md",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chrischen996/mini-agent-loop.git"
  },
  "bugs": {
    "url": "https://github.com/Chrischen996/mini-agent-loop/issues"
  },
  "homepage": "https://github.com/Chrischen996/mini-agent-loop#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "tui": "tsx src/tui/terminal-main.ts",
    "tui:terminal": "tsx src/tui/terminal-main.ts",
    "dev": "tsx watch src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "serve": "tsx src/server.ts",
    "build": "tsx build.ts",
    "generate-models": "tsx scripts/generate-models.ts",
    "generate-models:check": "tsx scripts/generate-models.ts --check",
    "build:package": "tsx build.ts && node -e \"const fs=require('node:fs'); fs.chmodSync('dist/cli.js', 0o755); fs.chmodSync('dist/tui.js', 0o755)\"",
    "prepack": "npm run build:package",
    "dev:inspect": "node --inspect=0.0.0.0:8888 --import tsx src/tui/terminal-main.ts",
    "tui:inspect": "tsx src/tui/terminal-main.ts --inspect=9229",
    "tui:inspect-brk": "tsx src/tui/terminal-main.ts --inspect-brk=9229",
    "test": "tsx --test \"test/*.test.ts\"",
    "test:coverage": "c8 tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "vite": "^6.3.5",
    "@rollup/plugin-node-resolve": "^16.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@earendil-works/pi-tui": "0.80.6",
    "@google/genai": "1.52.0",
    "@mistralai/mistralai": "2.2.6",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@opentelemetry/api": "1.9.0",
    "@smithy/node-http-handler": "4.7.3",
    "@smithy/types": "4.16.1",
    "docx": "^9.5.1",
    "express": "^5.2.1",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "openai": "6.26.0",
    "multer": "^2.2.0",
    "partial-json": "0.1.7",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pi-web-access": "0.18.0",
    "typebox": "1.1.38",
    "mammoth": "^1.8.0"
  }
}
